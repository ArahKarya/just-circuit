# Port for the API server (the Vite dev server proxies /api here)
API_PORT=8787
# Allow LLM base URLs that resolve to localhost / LAN (needed for Ollama).
# Set to false when the app is reachable from the internet.
# Default: true in development, false in production.
ALLOW_PRIVATE_LLM_HOSTS=true
# Interface to listen on (default 127.0.0.1 in dev, 0.0.0.0 in production)
# HOST=127.0.0.1
# Seconds the AI may stay silent before its first chunk (ms) / between chunks (ms)
# LLM_FIRST_CHUNK_TIMEOUT_MS=300000
# LLM_IDLE_TIMEOUT_MS=120000
# Requests per minute per IP for /api routes
JLC_RATE_LIMIT_PER_MINUTE=1200
RATE_LIMIT_PER_MINUTE=60

# Where projects, chats, AI settings and sessions are stored (default ~/cds-data).
# Each project is a plain folder you can open with `tsci dev`.
# CDS_DATA_DIR=~/cds-data
# Login password hash; create it with `pnpm set-password`.
# Required when HOST is not 127.0.0.1 (the server refuses to start otherwise).
# CDS_PASSWORD_HASH='scrypt$...'
# 32-byte key (64 hex chars) that encrypts API keys at rest.
# Default: generated once into CDS_DATA_DIR/secret.key (keep that file private).
# CDS_SECRET=
# Session cookie over HTTPS only (default true in production)
# COOKIE_SECURE=true
# SESSION_TTL_DAYS=30
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# Extra host names allowed in the Host header, comma separated (loopback is always allowed).
# Needed when you open CDS by name, e.g. through Tailscale: CDS_ALLOWED_HOSTS=raspi.tailnet.ts.net
# CDS_ALLOWED_HOSTS=
# In-browser terminal: a shell on this machine for the signed-in user (default on in dev, off in production).
# Without a password any program on this machine that can reach the port can open it; set a password on shared machines.
# ENABLE_TERMINAL=true
# TERMINAL_SHELL=/bin/zsh
# MAX_TERMINALS=8
