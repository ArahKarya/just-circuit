# Port for the API server (the Vite dev server proxies /api here)
API_PORT=8787
# Allow LLM base URLs that resolve to localhost / LAN (needed for Ollama).
# Set to false when the app is reachable from the internet.
# Default: true in development, false in production.
ALLOW_PRIVATE_LLM_HOSTS=true
# Interface to listen on (default 127.0.0.1 in dev, 0.0.0.0 in production)
# HOST=127.0.0.1
# Requests per minute per IP for /api routes
RATE_LIMIT_PER_MINUTE=60
